{
  "envelope": {
    "description": "Every response is wrapped in this shape (ApiResponseDto<T>). 'data' holds the actual payload described per-route below.",
    "shape": {
      "success": "boolean",
      "data": "T | null",
      "errors": "string[] | null",
      "timestamp": "string (ISO datetime)"
    }
  },
  "pagedList": {
    "description": "Every list route's 'data' is this shape (PagedList<T> serializes as an array with extra fields). Pagination info also comes back in the 'Pagination' response header as JSON: { currentPage, itemsPerPage, totalItems, totalPages }.",
    "shape": {
      "currentPage": "number",
      "totalPages": "number",
      "pageSize": "number",
      "totalCount": "number",
      "items": "T[] (the array itself — PagedList<T> extends List<T>, so in JSON it's a plain array with currentPage/totalPages/pageSize/totalCount as extra properties on it)"
    }
  },
  "enums": {
    "TargetZone": ["RedZone", "YellowZone", "GreenZone"],
