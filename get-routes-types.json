    "LeadTimeCategory": ["Short", "Medium", "Long"],
    "VariabilityCategory": ["Low", "Medium", "High"],
    "SpikeHorizonType": ["Dlt", "Days"],
    "SpikeThresholdType": ["Adu", "PlanningRedZone"],
