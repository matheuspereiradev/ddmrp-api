{
  "sources": [
    {
      "view": "Centers",
      "type": "Csv",
      "path": "Imports/centers.csv",
      "deleteNonSent": false,
      "key": ["Code"],
      "fieldMappings": [
        { "source": "Code", "target": "Code" },
        { "source": "Description", "target": "Description" },
        { "source": "City", "target": "City" },
        { "source": "Zone", "target": "Zone" }
      ]
    },
    {
      "view": "Products",
      "type": "Csv",
      "path": "Imports/products.csv",
      "deleteNonSent": false,
      "key": ["Reference"],
      "fieldMappings": [
        { "source": "MaterialCode", "target": "Reference" },
        { "source": "Description", "target": "Description" },
        { "source": "AuxiliarMaterialCode", "target": "AuxiliarMaterialCode" },
        { "source": "BarCode", "target": "Barcode" },
        { "source": "MeasurementUnit", "target": "UnitOfMeasure" },
        { "source": "Category", "target": "Category" },
        { "source": "Segment", "target": "Segment" },
        { "source": "GrossWeight", "target": "Weight" },
        { "source": "Volume", "target": "Volume" },
        { "source": "Value", "target": "Value" },
        { "source": "Pallet", "target": "Pallet" },
        { "source": "Line", "target": "Line" },
        { "source": "SubLine", "target": "Subline" },
        { "source": "ABC Class", "target": "ABC" },
        { "source": "Brand", "target": "Brand" },
        { "source": "WorkCenter", "target": "WorkCenter" }
      ]
    },
    {
      "view": "CenterProducts",
      "type": "Csv",
      "path": "Imports/center_products.csv",
      "deleteNonSent": false,
      "key": ["IdProduct", "IdCenter"],
      "fieldMappings": [
        { "source": "MaterialCode", "target": "IdProduct", "lookup": { "entity": "Product", "by": "Reference" } },
        { "source": "CenterCode", "target": "IdCenter", "lookup": { "entity": "Center", "by": "Code" } },
        { "source": "OriginCenterCode", "target": "IdOriginCenter", "lookup": { "entity": "Center", "by": "Code" }, "required": false },
        { "source": "PackQuantity", "target": "PackQuantity", "default": "1" },
        { "source": "MOQ", "target": "Moq", "default": "0" },
        { "source": "LeadTime", "target": "LeadTime", "default": "0" },
        { "source": "Frequency", "target": "Frequency", "default": "0" },
        { "target": "HistoryAduDays", "default": "90" },
        { "target": "FutureAduDays", "default": "0" }
      ]
    },
    {
      "view": "Forecast",
      "type": "Csv",
      "path": "Imports/forecast.csv",
      "deleteNonSent": false,
      "key": ["IdProduct", "IdCenter", "Date"],
      "fieldMappings": [
        { "source": "MaterialCode", "target": "IdProduct", "lookup": { "entity": "Product", "by": "Reference" } },
        { "source": "CenterCode", "target": "IdCenter", "lookup": { "entity": "Center", "by": "Code" } },
        { "source": "Quantity", "target": "Quantity" },
        { "source": "Date", "target": "Date" }
      ]
    },
    {
      "view": "History",
      "type": "Csv",
      "path": "Imports/history.csv",
      "deleteNonSent": false,
      "key": ["IdProduct", "IdCenter", "Date"],
      "fieldMappings": [
        { "source": "MaterialCode", "target": "IdProduct", "lookup": { "entity": "Product", "by": "Reference" } },
        { "source": "CenterCode", "target": "IdCenter", "lookup": { "entity": "Center", "by": "Code" } },
        { "source": "Quantity", "target": "Quantity" },
        { "source": "Date", "target": "Date" }
      ]
    },
    {
      "view": "Stock",
      "type": "Csv",
      "path": "Imports/stock.csv",
      "table": "CenterProducts",
      "allowInsert": false,
      "deleteNonSent": false,
      "key": ["IdProduct", "IdCenter"],
      "fieldMappings": [
        { "source": "MaterialCode", "target": "IdProduct", "lookup": { "entity": "Product", "by": "Reference" } },
        { "source": "CenterCode", "target": "IdCenter", "lookup": { "entity": "Center", "by": "Code" } },
        { "source": "Quantity", "target": "Stock" }
      ]
    },
    {
      "view": "ProductionOrder",
      "type": "Csv",
      "path": "Imports/production_orders.csv",
      "table": "Orders",
      "key": ["OrderNumber", "IdDestinyCenter", "IdProduct"],
      "fieldMappings": [
        { "source": "OrderNumber", "target": "OrderNumber" },
        { "source": "Partner", "target": "IdPartner", "lookup": { "entity": "Partner", "by": "Code" }, "required": false },
        { "source": "Center", "target": "IdDestinyCenter", "lookup": { "entity": "Center", "by": "Code" } },
        { "source": "Product", "target": "IdProduct", "lookup": { "entity": "Product", "by": "Reference" } },
        { "source": "Quantity", "target": "Quantity" },
        { "source": "DeliveredQuantity", "target": "DeliveredQuantity" },
        { "source": "MeasurementUnit", "target": "MeasurementUnit" },
        { "source": "Position", "target": "Position" },
        { "source": "CreationDate", "target": "CreationDate" },
        { "source": "DeliveryDate", "target": "DeliveryDate" },
        { "source": "Notes", "target": "Notes" },
        { "target": "Type", "default": "ProductionOrder" },
        { "target": "IsInbound", "default": "true" },
        { "target": "IsOutbound", "default": "false" }
      ]
    },
    {
      "view": "PurchaseOrder",
      "type": "Csv",
      "path": "Imports/purchase_orders.csv",
      "table": "Orders",
      "key": ["OrderNumber", "IdDestinyCenter", "IdProduct"],
      "fieldMappings": [
        { "source": "OrderNumber", "target": "OrderNumber" },
        { "source": "Partner", "target": "IdPartner", "lookup": { "entity": "Partner", "by": "Code" }, "required": false },
        { "source": "Center", "target": "IdDestinyCenter", "lookup": { "entity": "Center", "by": "Code" } },
        { "source": "Product", "target": "IdProduct", "lookup": { "entity": "Product", "by": "Reference" } },
        { "source": "Quantity", "target": "Quantity" },
        { "source": "DeliveredQuantity", "target": "DeliveredQuantity" },
        { "source": "MeasurementUnit", "target": "MeasurementUnit" },
        { "source": "Position", "target": "Position" },
        { "source": "CreationDate", "target": "CreationDate" },
        { "source": "DeliveryDate", "target": "DeliveryDate" },
        { "source": "Notes", "target": "Notes" },
        { "target": "Type", "default": "PurchaseOrder" },
        { "target": "IsInbound", "default": "true" },
        { "target": "IsOutbound", "default": "false" }
      ]
    },
    {
      "view": "SaleOrder",
      "type": "Csv",
      "path": "Imports/sale_orders.csv",
      "table": "Orders",
      "key": ["OrderNumber", "IdOriginCenter", "IdProduct"],
      "fieldMappings": [
        { "source": "OrderNumber", "target": "OrderNumber" },
        { "source": "Partner", "target": "IdPartner", "lookup": { "entity": "Partner", "by": "Code" }, "required": false },
        { "source": "Center", "target": "IdOriginCenter", "lookup": { "entity": "Center", "by": "Code" } },
        { "source": "Product", "target": "IdProduct", "lookup": { "entity": "Product", "by": "Reference" } },
        { "source": "Quantity", "target": "Quantity" },
        { "source": "DeliveredQuantity", "target": "DeliveredQuantity" },
        { "source": "MeasurementUnit", "target": "MeasurementUnit" },
        { "source": "Position", "target": "Position" },
        { "source": "CreationDate", "target": "CreationDate" },
        { "source": "DeliveryDate", "target": "DeliveryDate" },
        { "source": "Notes", "target": "Notes" },
        { "target": "Type", "default": "SaleOrder" },
        { "target": "IsInbound", "default": "false" },
        { "target": "IsOutbound", "default": "true" }
      ]
    },
    {
      "view": "Transfers",
      "type": "Csv",
      "path": "Imports/transfer_orders.csv",
      "table": "Orders",
      "key": ["OrderNumber", "IdDestinyCenter", "IdOriginCenter", "IdProduct"],
      "fieldMappings": [
        { "source": "OrderNumber", "target": "OrderNumber" },
        { "source": "Partner", "target": "IdPartner", "lookup": { "entity": "Partner", "by": "Code" }, "required": false },
        { "source": "DestinyCenter", "target": "IdDestinyCenter", "lookup": { "entity": "Center", "by": "Code" } },
        { "source": "OriginCenter", "target": "IdOriginCenter", "lookup": { "entity": "Center", "by": "Code" } },
        { "source": "Product", "target": "IdProduct", "lookup": { "entity": "Product", "by": "Reference" } },
        { "source": "Quantity", "target": "Quantity" },
        { "source": "DeliveredQuantity", "target": "DeliveredQuantity" },
        { "source": "MeasurementUnit", "target": "MeasurementUnit" },
        { "source": "Position", "target": "Position" },
        { "source": "CreationDate", "target": "CreationDate" },
        { "source": "DeliveryDate", "target": "DeliveryDate" },
        { "source": "Notes", "target": "Notes" },
        { "target": "Type", "default": "Transfer" },
        { "target": "IsInbound", "default": "true" },
        { "target": "IsOutbound", "default": "true" }
      ]
    }
  ]
}
